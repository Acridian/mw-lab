---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactCta from '../../components/ContactCta.astro';
import { getPublications } from '../../lib/publications';
import { SITE_URL } from '../../data/company';

const base = import.meta.env.BASE_URL;
const siteUrl = SITE_URL;

const publications = await getPublications();
const dateFormat = new Intl.DateTimeFormat('ru-RU', { year: 'numeric', month: 'long', day: 'numeric' });

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Публикации' },
  ],
};
---

<BaseLayout
  title="Публикации"
  description="Публикации Лаборатории Микроволн об оборудовании и системах спутниковой связи"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <header class="page-hero">
    <div class="shell">
      <nav class="breadcrumbs" aria-label="Хлебные крошки">
        <a href={base}>Главная</a><span aria-hidden="true">/</span><span aria-current="page">Публикации</span>
      </nav>
      <p class="eyebrow">Материалы и отраслевые издания</p>
      <h1 class="page-title">Публикации</h1>
    </div>
  </header>
  <section class="section">
    <div class="shell publication-grid">
      {
        publications.map((publication) => (
          <a
            class="publication-card"
            href={`${base}publications/${publication.slug}/`}
            target="_blank"
            rel="noopener noreferrer"
          >
            <div class="publication-media">
              <Image
                src={publication.image}
                alt={publication.entry.data.title}
                widths={[360, 600, 840]}
                sizes="(max-width: 640px) 100vw, (max-width: 980px) 50vw, 33vw"
              />
            </div>
            <div class="publication-copy">
              <time datetime={publication.entry.data.date.toISOString()}>
                {dateFormat.format(publication.entry.data.date)}
              </time>
              <h2>{publication.entry.data.title}</h2>
              <span>Открыть публикацию ↗</span>
            </div>
          </a>
        ))
      }
    </div>
  </section>
  <ContactCta />
</BaseLayout>
