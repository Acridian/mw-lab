---
import BaseLayout from '../../layouts/BaseLayout.astro';
import company from '../../data/company.json';
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Контакты" description="Контакты ООО «Лаборатория Микроволн» в Москве">
  <header class="page-hero">
    <div class="shell">
      <nav class="breadcrumbs" aria-label="Хлебные крошки">
        <a href={base}>Главная</a><span aria-hidden="true">/</span><span aria-current="page">Контакты</span>
      </nav>
      <p class="eyebrow">Москва</p>
      <h1 class="page-title">Контакты</h1>
    </div>
  </header>
  <section class="section">
    <div class="shell contact-layout">
      <div>
        <dl class="contact-list">
          <div class="contact-item">
            <dt>Телефон</dt><dd><a href={`tel:${company.phone.replace(/\D/g, '')}`}>{company.phoneDisplay}</a></dd>
          </div>
          <div class="contact-item">
            <dt>Почта</dt><dd><a href={`mailto:${company.email}`}>{company.email}</a></dd>
          </div>
          <div class="contact-item">
            <dt>Адрес</dt><dd>{company.address.postalCode}, {company.address.locality}, {company.address.street}</dd>
          </div>
        </dl>
        <div style="margin-top: 28px">
          <a
            class="button button-secondary"
            href={`${base}downloads/company-details.pdf`}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Карточка предприятия, PDF, откроется в новой вкладке"
          >
            Карточка предприятия (PDF)
          </a>
        </div>
      </div>
      <div class="contact-map">
        <div id="yandex-map" style="width:100%;height:400px">
          <script
            type="text/javascript"
            charset="utf-8"
            async
            src={company.yandexMapsConstructor}
            is:inline></script>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
