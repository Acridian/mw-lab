---
import Features2 from '~/components/widgets/Features2.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Hero from '~/components/widgets/Hero.astro';
import Stats from '~/components/widgets/Stats.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'О компании — Лаборатория Микроволн',
  description:
    'Лаборатория Микроволн — разработчик и производитель профессионального оборудования спутниковой связи с 2012 года. 11+ лет опыта, 83+ завершенных проектов.',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->
  <Hero
    tagline="О компании"
    image={{
      src: '~/assets/images/products/um2021-100-1-scaled.jpg',
      alt: 'Лаборатория Микроволн',
    }}
  >
    <Fragment slot="title">
      Разработчик и поставщик <br />
      <span class="text-accent dark:text-white highlight">профессионального оборудования</span>
      <br />спутниковой связи
    </Fragment>

    <Fragment slot="subtitle">
      <span class="text-lg">
        Команда молодых профессионалов, успешно реализующих современные решения для высокочастотной аппаратуры
        испытаний и средств связи авиакосмической отрасли и телекоммуникаций.
      </span>
    </Fragment>
  </Hero>

  <!-- Stats Widget ****************** -->
  <Stats
    title="Наши достижения"
    subtitle="Более 11 лет на рынке профессионального оборудования"
    stats={[
      { title: 'Основана', amount: '2012' },
      { title: 'Завершенных проектов', amount: '83+' },
      { title: 'Продуктов', amount: '43' },
      { title: 'Лет гарантии', amount: '10+' },
    ]}
  />

  <!-- Content Widget **************** -->
  <Content
    isReversed
    items={[
      {
        title: 'Опыт и экспертиза',
        description:
          'Более 11 лет успешной работы в области разработки и производства СВЧ-оборудования для спутниковой связи.',
        icon: 'tabler:award',
      },
      {
        title: 'Собственное производство',
        description:
          'Полный цикл разработки и производства позволяет контролировать качество на всех этапах и предлагать конкурентные цены.',
        icon: 'tabler:building-factory',
      },
      {
        title: 'Индивидуальный подход',
        description:
          'Разработка решений под специфические требования заказчика. Техническая поддержка на всех этапах проекта.',
        icon: 'tabler:users',
      },
    ]}
    image={{
      src: '~/assets/images/products/um2424-60m-3-scaled.jpg',
      alt: 'Производство оборудования',
    }}
  >
    <Fragment slot="content">
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl mb-4">Наша миссия</h2>
      <p class="text-lg text-muted dark:text-slate-400">
        Предоставление оптимальных и надежных технологических решений для профессиональной спутниковой связи.
        Адаптивные решения, отвечающие потребностям отрасли.
      </p>
    </Fragment>
  </Content>

  <!-- Features3 Widget ************** -->
  <Features3
    title="Наша специализация"
    subtitle="Производство высококачественного СВЧ-оборудования для различных отраслей"
    columns={3}
    isBeforeContent={true}
    items={[
      {
        title: 'Авиакосмическая отрасль',
        description:
          'Разработка и поставка оборудования для систем спутниковой связи авиакосмического назначения.',
        icon: 'tabler:rocket',
      },
      {
        title: 'Телекоммуникации',
        description:
          'Профессиональные решения для телекоммуникационных компаний и операторов связи.',
        icon: 'tabler:antenna',
      },
      {
        title: 'Испытательное оборудование',
        description:
          'Системы тестирования и измерения для высокочастотной аппаратуры.',
        icon: 'tabler:device-analytics',
      },
    ]}
  />

  <!-- Features2 Widget ************** -->
  <Features2
    title="Технические характеристики"
    subtitle="Широкий диапазон параметров производимого оборудования"
    items={[
      {
        title: 'Частотный диапазон',
        description: '800 МГц — 15 ГГц',
        icon: 'tabler:wave-sine',
      },
      {
        title: 'Выходная мощность',
        description: '1 Вт — 100 Вт',
        icon: 'tabler:bolt',
      },
      {
        title: 'Функциональность',
        description: 'Преобразование, коммутация, усиление сигналов',
        icon: 'tabler:arrows-right-left',
      },
      {
        title: 'Элементы тракта',
        description: 'Антенно-волноводные компоненты',
        icon: 'tabler:antenna-bars-5',
      },
      {
        title: 'Коаксиальные сборки',
        description: 'СВЧ-сборки различных конфигураций',
        icon: 'tabler:plug-connected',
      },
      {
        title: 'Степень защиты',
        description: 'IP65 для работы в сложных условиях',
        icon: 'tabler:shield-check',
      },
    ]}
  />

  <!-- Features3 Widget ************** -->
  <Features3
    title="Наши преимущества"
    subtitle="Что делает нас надежным партнером"
    columns={3}
    items={[
      {
        title: 'Минимальный разброс параметров',
        description: 'Строгий контроль качества обеспечивает стабильность характеристик производимой продукции.',
        icon: 'tabler:chart-dots',
      },
      {
        title: 'Максимальная надежность',
        description: 'Использование качественных компонентов и тщательное тестирование каждого изделия.',
        icon: 'tabler:certificate',
      },
      {
        title: 'Минимальные сроки поставки',
        description: 'Собственное производство позволяет оперативно выполнять заказы.',
        icon: 'tabler:clock-bolt',
      },
      {
        title: 'Техническая поддержка',
        description: 'Консультации специалистов на протяжении всего срока службы изделия (10+ лет).',
        icon: 'tabler:headset',
      },
      {
        title: 'Индивидуальные решения',
        description: 'Возможность разработки оборудования под специфические требования заказчика.',
        icon: 'tabler:adjustments',
      },
      {
        title: 'Полная документация',
        description: 'Паспорта, чертежи, протоколы испытаний и руководства по эксплуатации.',
        icon: 'tabler:file-description',
      },
    ]}
  />

  <!-- CallToAction Widget *********** -->
  <CallToAction
    title="Готовы начать работу?"
    subtitle="Свяжитесь с нами для обсуждения вашего проекта и получения коммерческого предложения"
    actions={[
      {
        variant: 'primary',
        text: 'Связаться с нами',
        href: '/contact',
      },
      {
        variant: 'secondary',
        text: 'Смотреть каталог',
        href: '/products',
      },
    ]}
  />
</Layout>
