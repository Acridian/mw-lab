---
import Layout from '~/layouts/PageLayout.astro';
import Header from '~/components/widgets/Header.astro';
import Hero from '~/components/widgets/Hero.astro';
import Stats from '~/components/widgets/Stats.astro';
import Features from '~/components/widgets/Features.astro';
import FeaturedProducts from '~/components/widgets/FeaturedProducts.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

import { headerData } from '~/navigation';

const metadata = {
  title: 'Лаборатория Микроволн — Профессиональное оборудование спутниковой связи',
  description:
    'Разработка и производство профессионального оборудования спутниковой связи. Усилители мощности, преобразователи частоты, системы резервирования. Более 10 лет опыта.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Fragment slot="header">
    <Header {...headerData} isSticky showToggleTheme />
  </Fragment>

  <!-- Hero Section ******************* -->
  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Смотреть продукцию',
        href: '/products',
        icon: 'tabler:package',
      },
      { text: 'Связаться с нами', href: '/contact', icon: 'tabler:mail' },
    ]}
    image={{
      src: '~/assets/images/hero-image.jpg',
      alt: 'Оборудование спутниковой связи MW-Lab',
    }}
  >
    <Fragment slot="title">
      Разработчик и поставщик оборудования
      <span class="text-accent dark:text-white highlight"> спутниковой связи</span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="text-lg"> Адаптивные решения для профессиональной связи </span>
    </Fragment>
  </Hero>

  <!-- Stats Widget ******************* -->
  <Stats
    title="Наши достижения"
    stats={[
      { title: 'Лет опыта', amount: '11' },
      { title: 'Завершенных проектов', amount: '83' },
      { title: 'Продуктов в каталоге', amount: '28' },
      { title: 'Категорий оборудования', amount: '6' },
    ]}
  />

  <!-- Features Widget *************** -->
  <Features
    id="features"
    title="Почему выбирают нас"
    subtitle="Преимущества работы с Лабораторией Микроволн"
    columns={3}
    items={[
      {
        title: 'Собственная разработка',
        description:
          'Полный цикл разработки и производства оборудования. Индивидуальные решения под требования заказчика.',
        icon: 'tabler:bulb',
      },
      {
        title: 'Высокое качество',
        description:
          'Использование современных технологий и компонентов. Строгий контроль качества на всех этапах производства.',
        icon: 'tabler:certificate',
      },
      {
        title: 'Надежность',
        description: 'Оборудование с защитой IP65 для работы в сложных климатических условиях. Защита от КЗ и ХХ.',
        icon: 'tabler:shield-check',
      },
      {
        title: 'Техническая поддержка',
        description: 'Полная техническая документация. Консультации специалистов на всех этапах внедрения.',
        icon: 'tabler:headset',
      },
      {
        title: 'Гибкие сроки поставки',
        description: 'Индивидуальный подход к каждому заказу. Возможность изготовления под заказ.',
        icon: 'tabler:clock',
      },
      {
        title: 'Конкурентные цены',
        description: 'Прямые поставки от производителя. Оптимальное соотношение цены и качества.',
        icon: 'tabler:discount',
      },
    ]}
  />

  <!-- Featured Products Widget *************** -->
  <FeaturedProducts
    title="Популярная продукция"
    subtitle="Наиболее востребованные решения для спутниковой связи"
    linkText="Смотреть весь каталог"
    linkUrl="/products"
    count={6}
  />

  <!-- Latest Posts Widget **************** -->
  <BlogLatestPosts
    title="Публикации"
    information="Новости компании, участие в выставках и отраслевых мероприятиях"
    linkText="Все публикации"
    linkUrl="/publikatsii"
    count={3}
  />

  <!-- CallToAction Widget *********** -->
  <CallToAction
    title="Готовы обсудить ваш проект?"
    subtitle="Свяжитесь с нами для получения консультации и коммерческого предложения"
    actions={[
      {
        variant: 'primary',
        text: 'Связаться с нами',
        href: '/contact',
      },
      {
        variant: 'secondary',
        text: 'Смотреть продукцию',
        href: '/products',
      },
    ]}
  />
</Layout>
