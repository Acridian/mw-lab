---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProductCard from '../../../components/ProductCard.astro';
import ContactCta from '../../../components/ContactCta.astro';
import {
  categories,
  getProductsByCategory,
  type ProductCategory,
  type ProductRecord,
} from '../../../lib/catalog';

const plural = (n: number, one: string, few: string, many: string) => {
  const m10 = n % 10,
    m100 = n % 100;
  if (m10 === 1 && m100 !== 11) return one;
  if (m10 >= 2 && m10 <= 4 && (m100 < 12 || m100 > 14)) return few;
  return many;
};

export async function getStaticPaths() {
  return Promise.all(
    categories.map(async (category) => ({
      params: { category: category.slug },
      props: { category, products: await getProductsByCategory(category.slug) },
    })),
  );
}

interface Props {
  category: ProductCategory;
  products: ProductRecord[];
}

const { category, products } = Astro.props;
---

<BaseLayout title={category.title} description={category.description}>
  <header class="page-hero">
    <div class="shell">
      <nav class="breadcrumbs" aria-label="Хлебные крошки">
        <a href="/">Главная</a><span aria-hidden="true">/</span><a href="/catalog/">Продукция</a><span
          aria-hidden="true">/</span
        ><span aria-current="page">{category.title}</span>
      </nav>
      <p class="eyebrow">
        Каталог · {products.length}
        {plural(products.length, 'изделие', 'изделия', 'изделий')}
      </p>
      <h1 class="page-title">{category.title}</h1>
      <p class="page-lead">{category.description}</p>
    </div>
  </header>
  <section class="section">
    <div class="shell product-grid">
      {products.map((product) => <ProductCard {product} />)}
    </div>
  </section>
  <ContactCta />
</BaseLayout>
