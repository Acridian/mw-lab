---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProductCard from '../../../components/ProductCard.astro';
import ContactCta from '../../../components/ContactCta.astro';
import company from '../../../data/company.json';
import {
  categories,
  getProductsByCategory,
  type ProductCategory,
  type ProductRecord,
} from '../../../lib/catalog';
import { plural } from '../../../lib/i18n';

const base = import.meta.env.BASE_URL;
const siteUrl = SITE_URL;

export async function getStaticPaths() {
  return Promise.all(
    categories.map(async (category) => ({
      params: { category: category.slug },
      props: { category, products: await getProductsByCategory(category.slug) },
    })),
  );
}

interface Props {
  category: ProductCategory;
  products: ProductRecord[];
}

const { category, products } = Astro.props;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Продукция', item: `${siteUrl}catalog/` },
    { '@type': 'ListItem', position: 3, name: category.title },
  ],
};
---

<BaseLayout title={category.title} description={category.description}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <header class="page-hero">
    <div class="shell">
      <nav class="breadcrumbs" aria-label="Хлебные крошки">
        <a href={base}>Главная</a><span aria-hidden="true">/</span><a href={`${base}catalog/`}>Продукция</a
        ><span aria-hidden="true">/</span><span aria-current="page">{category.title}</span>
      </nav>
      <p class="eyebrow">
        Каталог · {products.length}
        {plural(products.length, 'изделие', 'изделия', 'изделий')}
      </p>
      <h1 class="page-title">{category.title}</h1>
      <p class="page-lead">{category.description}</p>
    </div>
  </header>
  <section class="section">
    <div class="shell product-grid">
      {products.map((product) => <ProductCard {product} />)}
    </div>
  </section>
  <ContactCta />
</BaseLayout>
