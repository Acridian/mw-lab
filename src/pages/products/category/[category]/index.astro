---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import Layout from '~/layouts/PageLayout.astro';
import ProductGrid from '~/components/products/ProductGrid.astro';
import Headline from '~/components/ui/Headline.astro';
import Button from '~/components/ui/Button.astro';

export const prerender = true;

export const getStaticPaths = (async () => {
  const categories = {
    'antenna-elements': {
      title: 'Элементы антенно-волноводного тракта',
      description: 'Антенны, волноводы и другие элементы антенно-волноводного тракта для систем спутниковой связи',
    },
    'power-amplifiers': {
      title: 'Усилители мощности',
      description: 'Профессиональные усилители мощности для различных частотных диапазонов',
    },
    'redundancy-systems': {
      title: 'Системы резервирования 1:1',
      description: 'Системы резервирования для обеспечения надежности работы оборудования',
    },
    'frequency-converters': {
      title: 'Преобразователи частоты',
      description: 'Преобразователи частоты для систем спутниковой связи',
    },
    'signal-switches': {
      title: 'Коммутаторы сигналов',
      description: 'Коммутационное оборудование для управления сигналами',
    },
    'signal-generators': {
      title: 'Генераторы сигналов',
      description: 'Генераторы сигналов для тестирования и калибровки оборудования',
    },
  };

  const allProducts = await getCollection('product', ({ data }) => {
    return data.draft !== true;
  });

  return Object.keys(categories).map((category) => {
    const categoryProducts = allProducts
      .filter((p) => p.data.category === category)
      .sort((a, b) => a.data.title.localeCompare(b.data.title, 'ru'));

    return {
      params: { category },
      props: {
        products: categoryProducts,
        categoryInfo: categories[category as keyof typeof categories]
      },
    };
  });
}) satisfies GetStaticPaths;

const { products, categoryInfo } = Astro.props;

const metadata = {
  title: `${categoryInfo.title} — Лаборатория Микроволн`,
  description: categoryInfo.description,
  robots: {
    index: true,
    follow: true,
  },
};
---

<Layout metadata={metadata}>
  <section class="px-6 sm:px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-7xl">
    <Headline>
      <Fragment slot="title">{categoryInfo.title}</Fragment>
      <Fragment slot="subtitle">{categoryInfo.description}</Fragment>
    </Headline>

    <div class="mb-8">
      <Button href="/products" variant="link">
        ← Все категории
      </Button>
    </div>

    {
      products.length > 0 ? (
        <>
          <p class="text-lg text-gray-600 dark:text-gray-400 mb-8">
            Найдено продуктов: {products.length}
          </p>
          <ProductGrid products={products} />
        </>
      ) : (
        <div class="text-center py-12">
          <p class="text-xl text-gray-600 dark:text-gray-400">В этой категории пока нет продуктов</p>
          <Button href="/products" variant="primary" class="mt-6">
            Смотреть все продукты
          </Button>
        </div>
      )
    }
  </section>
</Layout>
