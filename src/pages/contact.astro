---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import ContactUs from '~/components/widgets/Contact.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: 'Контакты — Лаборатория Микроволн',
  description: 'Свяжитесь с нами для получения консультации и коммерческого предложения. Email: info@mw-lab.ru',
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget ******************* -->
  <HeroText tagline="Контакты" title="Свяжитесь с нами!" />

  <!-- Contact Form Widget ******************* -->
  <ContactUs
    id="form"
    title="Отправьте нам сообщение"
    subtitle="Заполните форму ниже, и наши специалисты свяжутся с вами в ближайшее время для обсуждения вашего проекта."
    inputs={[
      {
        type: 'text',
        name: 'name',
        label: 'Ваше имя',
        placeholder: 'Иван Иванов',
      },
      {
        type: 'email',
        name: 'email',
        label: 'Email',
        placeholder: 'ivan@example.com',
      },
      {
        type: 'tel',
        name: 'phone',
        label: 'Телефон',
        placeholder: '+7 (___) ___-__-__',
      },
    ]}
    textarea={{
      label: 'Сообщение',
      placeholder: 'Опишите ваши требования к оборудованию...',
      rows: 6,
    }}
    disclaimer={{
      label:
        'Отправляя эту форму, вы соглашаетесь с обработкой ваших персональных данных в соответствии с нашей политикой конфиденциальности.',
    }}
    description="Наша команда обычно отвечает в течение 1-2 рабочих дней."
  />

  <!-- Contact Information Widget ************** -->
  <Features2
    title="Как с нами связаться"
    subtitle="Выберите удобный для вас способ связи"
    columns={3}
    items={[
      {
        title: 'Телефон',
        description: '+7 915 008-3616',
        icon: 'tabler:phone',
      },
      {
        title: 'Email',
        description: 'info@mw-lab.ru',
        icon: 'tabler:mail',
      },
      {
        title: 'Адрес',
        description: '124460, Москва, Зеленоград, ул. Конструктора Гуськова, дом 8',
        icon: 'tabler:map-pin',
      },
      {
        title: 'Рабочие часы',
        description: 'Пн-Пт: 9:00 - 18:00 (МСК)',
        icon: 'tabler:clock',
      },
    ]}
  />

  <!-- Additional Information Widget ************** -->
  <Features2
    title="Дополнительная информация"
    subtitle="Что включить в запрос"
    columns={2}
    items={[
      {
        title: 'Техническая консультация',
        description:
          'Для получения технической консультации укажите предполагаемые параметры оборудования: частотный диапазон, выходную мощность, требования к габаритам и условиям эксплуатации.',
        icon: 'tabler:help-circle',
      },
      {
        title: 'Коммерческое предложение',
        description:
          'Для подготовки коммерческого предложения укажите интересующую продукцию, требуемое количество, желаемые сроки поставки и контактные данные для связи.',
        icon: 'tabler:file-invoice',
      },
      {
        title: 'Индивидуальная разработка',
        description:
          'Если вам требуется разработка оборудования под специфические требования, опишите задачу максимально подробно: область применения, технические параметры, особые требования.',
        icon: 'tabler:tool',
      },
      {
        title: 'Техническая поддержка',
        description:
          'При обращении по вопросам технической поддержки укажите модель оборудования, номер изделия и подробное описание вопроса или проблемы.',
        icon: 'tabler:lifebuoy',
      },
    ]}
  />
</Layout>
