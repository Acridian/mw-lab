---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: 'Контакты — Лаборатория Микроволн',
  description:
    'Свяжитесь с нами для получения консультации и коммерческого предложения. Телефон: +7 915 008-3616, Email: info@mw-lab.ru',
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget ******************* -->
  <HeroText
    tagline="Контакты"
    title="Свяжитесь с нами!"
    subtitle="Мы всегда рады ответить на ваши вопросы и обсудить ваш проект"
  />

  <!-- Contact Information Widget ************** -->
  <Features2
    columns={2}
    items={[
      {
        title: 'Телефон',
        description: '+7 916 732-9026',
        icon: 'tabler:phone',
      },
      {
        title: 'Email',
        description: 'info@mw-lab.ru',
        icon: 'tabler:mail',
      },
      {
        title: 'Адрес',
        description: '124460, Москва, Зеленоград, ул. Конструктора Гуськова, дом 8',
        icon: 'tabler:map-pin',
      },
      {
        title: 'Рабочие часы',
        description: 'Пн-Пт: 9:00 - 18:00 (МСК)',
        icon: 'tabler:clock',
      },
    ]}
  />

  <!-- Additional Information Widget ************** -->
  <Features2
    title="Чем мы можем помочь"
    subtitle="Наши услуги"
    columns={2}
    items={[
      {
        title: 'Техническая консультация',
        description:
          'Предоставляем профессиональные консультации по выбору оборудования, его параметрам и возможностям применения в различных условиях эксплуатации.',
        icon: 'tabler:help-circle',
      },
      {
        title: 'Коммерческое предложение',
        description:
          'Подготовим индивидуальное коммерческое предложение с учетом ваших требований, объемов и сроков поставки.',
        icon: 'tabler:file-invoice',
      },
      {
        title: 'Индивидуальная разработка',
        description:
          'Разрабатываем оборудование под специфические требования заказчика с учетом особенностей применения и технических параметров.',
        icon: 'tabler:tool',
      },
      {
        title: 'Техническая поддержка',
        description:
          'Оказываем техническую поддержку по эксплуатации оборудования, помогаем в решении возникающих вопросов и проблем.',
        icon: 'tabler:lifebuoy',
      },
    ]}
  />
</Layout>
