---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Страница не найдена" description="Запрошенная страница не найдена" noindex>
  <section class="not-found">
    <div class="shell">
      <strong>404</strong>
      <h1>Страница не найдена</h1>
      <p>Проверьте адрес или перейдите в каталог продукции.</p>
      <a class="button" href="/catalog/">Перейти в каталог</a>
    </div>
  </section>
</BaseLayout>
