---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import company from '../../data/company.json';

const base = import.meta.env.BASE_URL;
const siteUrl = company.siteUrl;

const page = await getEntry('pages', 'privacy-policy');
if (!page) throw new Error('Privacy policy content is missing');
const { Content } = await render(page);

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Политика конфиденциальности' },
  ],
};
---

<BaseLayout
  title={page.data.title}
  description={`Политика конфиденциальности сайта ${company.siteUrl.replace('https://', '')}`}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <header class="page-hero">
    <div class="shell">
      <nav class="breadcrumbs" aria-label="Хлебные крошки">
        <a href={base}>Главная</a><span aria-hidden="true">/</span><span aria-current="page"
          >Политика конфиденциальности</span
        >
      </nav>
      <p class="eyebrow">Правовая информация</p>
      <h1 class="page-title">{page.data.title}</h1>
    </div>
  </header>
  <div class="shell legal-layout">
    <aside class="legal-note">Редакция {page.data.date.toLocaleDateString('ru-RU')}</aside>
    <article class="legal-copy rich-copy"><Content /></article>
  </div>
</BaseLayout>
