---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
}

const { title, description, image = `${import.meta.env.BASE_URL}assets/og.png`, noindex = false } = Astro.props;
const isDeployPreview = ['deploy-preview', 'branch-deploy'].includes(process.env.CONTEXT ?? '');
const robots = isDeployPreview ? 'noindex, nofollow' : noindex ? 'noindex, follow' : 'index, follow';
const canonical = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title.includes('Лаборатория микроволн') ? title : `${title} | Лаборатория микроволн`;
const imageUrl = new URL(image, Astro.site);
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Лаборатория микроволн',
  url: Astro.site?.href,
  logo: new URL('/assets/logo.png', Astro.site).href,
  email: 'info@mw-lab.ru',
  telephone: '+7 917 501-21-21',
  address: {
    '@type': 'PostalAddress',
    postalCode: '124460',
    addressLocality: 'Москва, Зеленоград',
    streetAddress: 'проезд 4801, д. 7, стр. 5',
    addressCountry: 'RU',
  },
};
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}assets/favicon.png`} />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Лаборатория микроволн" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(organization)} />
  </head>
  <body>
    <a class="skip-link" href="#main">К содержанию</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
