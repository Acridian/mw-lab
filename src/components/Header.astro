---
const navigation = [
  { href: '/', label: 'Главная' },
  { href: '/catalog/', label: 'Продукция' },
  { href: '/publikatsii/', label: 'Публикации' },
  { href: '/kontakty/', label: 'Контакты' },
];

const pathname = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === '/'
    ? pathname === '/'
    : pathname.startsWith(href) || (href === '/catalog/' && pathname.startsWith('/tovary/'));
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href="/" aria-label="Лаборатория микроволн, главная">
      <img src="/assets/logo.png" width="320" height="75" alt="Лаборатория микроволн" />
    </a>
    <nav class="desktop-nav" aria-label="Основная навигация">
      {
        navigation.map((item) => (
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>
    <div class="header-contact">
      <a href="tel:+79175012121">+7 (917) 501-2121</a>
      <span>Москва · Зеленоград</span>
    </div>
    <details class="mobile-nav">
      <summary>Меню</summary>
      <nav class="mobile-links" aria-label="Мобильная навигация">
        {
          navigation.map((item) => (
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ))
        }
        <a href="tel:+79175012121">+7 (917) 501-2121</a>
      </nav>
    </details>
  </div>
</header>
