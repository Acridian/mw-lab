---
const base = import.meta.env.BASE_URL;
const navigation = [
  { href: '', label: 'Главная' },
  { href: 'catalog/', label: 'Продукция' },
  { href: 'publications/', label: 'Публикации' },
  { href: 'contact/', label: 'Контакты' },
];

const pathname = Astro.url.pathname;
const fullPath = (href: string) => `${base}${href}`;
const isCurrent = (href: string) => {
  const fp = fullPath(href);
  return fp === base
    ? pathname === base
    : pathname.startsWith(fp) || (fp === `${base}catalog/` && pathname.startsWith(`${base}products/`));
};
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href={base} aria-label="Лаборатория микроволн, главная">
      <img src={`${base}assets/logo.png`} width="320" height="75" alt="Лаборатория микроволн" />
    </a>
    <nav class="desktop-nav" aria-label="Основная навигация">
      {
        navigation.map((item) => (
          <a href={fullPath(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>
    <div class="header-contact">
      <a href="tel:+79175012121">+7 (917) 501-2121</a>
      <a href="mailto:info@mw-lab.ru" class="header-mail">info@mw-lab.ru</a>
    </div>
    <details class="mobile-nav">
      <summary>Меню</summary>
      <nav class="mobile-links" aria-label="Мобильная навигация">
        {
          navigation.map((item) => (
            <a href={fullPath(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ))
        }
        <a href="tel:+79175012121">+7 (917) 501-2121</a>
      </nav>
    </details>
  </div>
</header>
