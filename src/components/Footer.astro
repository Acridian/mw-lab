---
import { categories } from '../lib/catalog';
import company from '../data/company.json';
const base = import.meta.env.BASE_URL;
---

<footer class="site-footer">
  <div class="shell">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href={base} aria-label="На главную">
          <img src={`${base}assets/logo.png`} width="320" height="75" alt={company.name} />
        </a>
        <p>Более 10 лет разрабатываем и поставляем профессиональное оборудование спутниковой связи</p>
      </div>
      <div class="footer-column">
        <h2>Продукция</h2>
        {categories.map((category) => <a href={`${base}products/${category.slug}/`}>{category.title}</a>)}
      </div>
      <div class="footer-column">
        <h2>Компания</h2>
        <a href={`${base}publications/`}>Публикации</a>
        <a href={`${base}contact/`}>Контакты</a>
        <a href={`${base}privacy-policy/`}>Политика конфиденциальности</a>
        <a href={`mailto:${company.email}`}>{company.email}</a>
        <a href={`tel:${company.phone.replace(/\D/g, '')}`}>{company.phoneDisplay}</a>
      </div>
    </div>
    <div class="footer-bottom">
      <span>Copyright © {new Date().getFullYear()} {company.name}</span>
    </div>
  </div>
</footer>
