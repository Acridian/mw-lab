---
import { getCollection } from 'astro:content';
import ProductGrid from '~/components/products/ProductGrid.astro';
import Button from '~/components/ui/Button.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import type { Widget } from '~/types';

export interface Props extends Widget {
  title?: string;
  subtitle?: string;
  linkText?: string;
  linkUrl?: string | URL;
  count?: number;
}

const {
  title = 'Наша продукция',
  subtitle = 'Профессиональное оборудование спутниковой связи',
  linkText = 'Смотреть все продукты',
  linkUrl = '/products',
  count = 6,
  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;

// Get featured products or latest products
const allProducts = await getCollection('product', ({ data }) => {
  return data.draft !== true;
});

// Prioritize featured products, then by date
const products = allProducts
  .sort((a, b) => {
    if (a.data.featured && !b.data.featured) return -1;
    if (!a.data.featured && b.data.featured) return 1;
    return (b.data.publishDate?.getTime() || 0) - (a.data.publishDate?.getTime() || 0);
  })
  .slice(0, count);
---

<WidgetWrapper id={id} isDark={isDark} containerClass={classes?.container as string} bg={bg}>
  <div class="flex flex-col lg:justify-between lg:flex-row mb-8">
    <div class="md:max-w-2xl">
      {
        title && (
          <h2
            class="text-3xl font-bold tracking-tight sm:text-4xl sm:leading-none group font-heading mb-2"
            set:html={title}
          />
        )
      }
      {subtitle && <p class="text-muted dark:text-slate-400 text-xl" set:html={subtitle} />}
    </div>

    {
      linkText && linkUrl && (
        <div class="flex items-center mt-4 lg:mt-0">
          <Button variant="link" href={linkUrl}>
            {linkText} »
          </Button>
        </div>
      )
    }
  </div>

  <ProductGrid products={products} />
</WidgetWrapper>
