---
import { Image } from 'astro:assets';
import type { ProductRecord } from '../lib/catalog';

const base = import.meta.env.BASE_URL;

interface Props {
  product: ProductRecord;
}

const { product } = Astro.props;
---

<a class="product-card" href={`${base}catalog/${product.slug}/`}>
  <div class="product-card-image">
    <Image
      src={product.image}
      alt={product.entry.data.title}
      widths={[320, 520, 760]}
      sizes="(max-width: 640px) 100vw, (max-width: 980px) 50vw, 33vw"
    />
  </div>
  <div class="product-card-copy">
    <span class="product-card-meta">{product.category.title}</span>
    <h2>{product.entry.data.title}</h2>
    <p>{product.excerpt}</p>
  </div>
  <span class="card-action" aria-hidden="true">Открыть</span>
</a>
