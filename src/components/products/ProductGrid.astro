---
import ProductGridItem from '~/components/products/ProductGridItem.astro';
import type { CollectionEntry } from 'astro:content';

export interface Props {
  products: Array<CollectionEntry<'product'>>;
}

const { products } = Astro.props;
---

<div class="grid gap-6 row-gap-5 md:grid-cols-2 lg:grid-cols-3 -mb-6">
  {products.map((product) => <ProductGridItem product={product} />)}
</div>
